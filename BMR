    </div>
    <p class="upd">Última atualização: 21 de novembro de 2026</p>
  </div>
</header>

<div class="topbar" id="conteudo">
  <div class="tb-in">
    <button class="iconbtn" id="menu" type="button" aria-label="Abrir índice"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
    <a class="brand" href="#top-of-page"><i></i>BMR</a>
    <label class="search">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" type="search" placeholder="Buscar no manual" autocomplete="off" aria-label="Buscar no manual">
      <kbd>/</kbd>
    </label>
    <button class="iconbtn" id="theme" type="button" aria-label="Alternar tema claro e escuro"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></button>
    <div class="filters" role="group" aria-label="Filtros">
      <button class="fchip" type="button" data-f="all" aria-pressed="true">Todas</button>
