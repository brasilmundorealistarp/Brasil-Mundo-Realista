<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Manual Oficial BMR Roleplay</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@500;600;700;800&display=swap">
<style>
/* Layout: capa escura em tela cheia, barra de busca fixa, índice lateral e capítulos recolhíveis em cartões. */
:root{
  --bg:#0B0712; --surface:#140D22; --surface2:#1E1432; --line:#2D2148;
  --fg:#F4F0FB; --muted:#A99CC6; --accent:#9B5CFF; --accent2:#C9A6FF; --on-accent:#fff;
  --warn:#F6C25B; --warn-bg:rgba(246,194,91,.14); --danger:#FF7A98; --danger-bg:rgba(255,122,152,.14);
  --shadow:0 10px 30px rgba(0,0,0,.35);
  --cover-bg:#07040D; --cover-fg:#fff; --cover-muted:#BBA9DD;
  --display:'Sora','Inter',system-ui,sans-serif; --body:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
  --gutter-l:max(16px, env(safe-area-inset-left, 0px)); --gutter-r:max(16px, env(safe-area-inset-right, 0px));
  color-scheme:dark;
}
@media (prefers-color-scheme: light){:root:not([data-theme="dark"]){
  --bg:#FAF8FF; --surface:#FFFFFF; --surface2:#F1EAFF; --line:#E2D8F5;
  --fg:#150C26; --muted:#5F5380; --accent:#6D28D9; --accent2:#5B21B6;
  --warn:#8A5200; --warn-bg:rgba(214,140,0,.14); --danger:#B3203F; --danger-bg:rgba(179,32,63,.10);
  --shadow:0 10px 30px rgba(70,30,140,.10); color-scheme:light}}
:root[data-theme="light"]{
  --bg:#FAF8FF; --surface:#FFFFFF; --surface2:#F1EAFF; --line:#E2D8F5;
  --fg:#150C26; --muted:#5F5380; --accent:#6D28D9; --accent2:#5B21B6;
  --warn:#8A5200; --warn-bg:rgba(214,140,0,.14); --danger:#B3203F; --danger-bg:rgba(179,32,63,.10);
  --shadow:0 10px 30px rgba(70,30,140,.10); color-scheme:light}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:132px}
body{background:var(--bg);color:var(--fg);font:16px/1.6 var(--body);-webkit-font-smoothing:antialiased;overflow-x:hidden}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:60;background:var(--bg)}
a{color:inherit}
h1,h2,h3{font-family:var(--display);margin:0;text-wrap:balance}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--accent2);outline-offset:2px;border-radius:6px}
#bar{position:fixed;left:0;right:0;top:env(safe-area-inset-top,0px);height:3px;z-index:70;background:linear-gradient(90deg,var(--accent),var(--accent2));transform:scaleX(0);transform-origin:left}

/* Capa */
.hero{margin-top:calc(-1 * env(safe-area-inset-top,0px));padding-top:calc(env(safe-area-inset-top,0px) + 56px);padding-bottom:64px;color:var(--cover-fg);position:relative;overflow:hidden;
  background:radial-gradient(900px 480px at 85% -10%,rgba(155,92,255,.55),transparent 60%),radial-gradient(700px 420px at 0% 110%,rgba(109,40,217,.45),transparent 60%),var(--cover-bg)}
.hero::after{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);background-size:44px 44px;mask-image:linear-gradient(180deg,#000,transparent 85%);-webkit-mask-image:linear-gradient(180deg,#000,transparent 85%);pointer-events:none}
.hero-in{position:relative;z-index:1;max-width:1100px;margin:0 auto;padding-left:var(--gutter-l);padding-right:var(--gutter-r)}
.tagline{display:inline-flex;gap:10px;align-items:center;font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--cover-muted);border:1px solid rgba(201,166,255,.35);padding:6px 14px;border-radius:999px;background:rgba(155,92,255,.12)}
.tagline i{width:7px;height:7px;border-radius:50%;background:#B98BFF;box-shadow:0 0 12px #B98BFF}
.hero h1{font-size:clamp(2.8rem,9vw,6rem);line-height:.98;font-weight:800;letter-spacing:-.03em;margin:26px 0 10px}
.hero h1 span{background:linear-gradient(100deg,#fff 10%,#C9A6FF 70%);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero h2{font-size:clamp(1.15rem,3vw,1.7rem);font-weight:600;color:#E6D9FF;letter-spacing:.02em}
.hero p.sub{max-width:56ch;color:var(--cover-muted);margin:20px 0 0;font-size:1.05rem}
.cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
.btn{display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border-radius:12px;font-weight:600;text-decoration:none;border:1px solid transparent;transition:transform .15s,background .15s}
.btn:hover{transform:translateY(-2px)}
.btn.primary{background:linear-gradient(135deg,#9B5CFF,#6D28D9);color:#fff;box-shadow:0 8px 28px rgba(109,40,217,.5)}
.btn.ghost{border-color:rgba(255,255,255,.28);color:#fff;background:rgba(255,255,255,.06)}
.stats{display:flex;flex-wrap:wrap;gap:34px;margin-top:46px;padding-top:26px;border-top:1px solid rgba(255,255,255,.14)}
.stats b{display:block;font:700 2rem/1 var(--display);color:#fff}
.stats span{font-size:.82rem;color:var(--cover-muted);letter-spacing:.06em;text-transform:uppercase}
.upd{margin-top:28px;font-size:.85rem;color:var(--cover-muted)}

/* Barra fixa */
.topbar{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.tb-in{max-width:1200px;margin:0 auto;padding:10px var(--gutter-r) 10px var(--gutter-l);display:flex;flex-wrap:wrap;gap:10px 12px;align-items:center}
.brand{font:800 1rem var(--display);letter-spacing:.04em;text-decoration:none;display:flex;align-items:center;gap:8px;margin-right:4px}
.brand i{width:12px;height:12px;border-radius:4px;background:linear-gradient(135deg,var(--accent2),var(--accent));display:inline-block}
.search{flex:1 1 220px;min-width:0;position:relative}
.search input{width:100%;padding:10px 40px 10px 40px;border-radius:12px;border:1px solid var(--line);background:var(--surface);color:var(--fg);font:inherit;font-size:.95rem}
.search input::placeholder{color:var(--muted)}
.search svg{position:absolute;left:12px;top:50%;translate:0 -50%;color:var(--muted);pointer-events:none}
.search kbd{position:absolute;right:10px;top:50%;translate:0 -50%;font:500 .72rem var(--body);color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:1px 6px}
.iconbtn{width:40px;height:40px;border-radius:12px;border:1px solid var(--line);background:var(--surface);display:grid;place-items:center}
.iconbtn:hover{border-color:var(--accent)}
#menu{display:none}
.filters{display:flex;flex-wrap:wrap;gap:8px;width:100%;align-items:center}
.fchip{padding:5px 13px;border-radius:999px;border:1px solid var(--line);background:transparent;font-size:.84rem;color:var(--muted)}
.fchip[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.fchip:hover{border-color:var(--accent)}
.status{margin-left:auto;font-size:.82rem;color:var(--muted)}
.linkbtn{background:none;border:0;color:var(--accent2);font-size:.84rem;padding:5px 4px;text-decoration:underline;text-underline-offset:3px}

/* Estrutura */
.shell{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:270px minmax(0,1fr);gap:44px;padding:36px var(--gutter-r) 80px var(--gutter-l)}
.side{position:sticky;top:calc(env(safe-area-inset-top,0px) + 128px);align-self:start;max-height:calc(100vh - 150px);overflow:auto;padding-right:4px}
.side h4{font:600 .72rem var(--body);letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:0 0 10px 10px}
.side a{display:flex;gap:10px;align-items:center;padding:8px 10px;border-radius:10px;text-decoration:none;font-size:.9rem;color:var(--muted);line-height:1.3}
.side a:hover{background:var(--surface2);color:var(--fg)}
.side a.on{background:var(--surface2);color:var(--fg);box-shadow:inset 3px 0 0 var(--accent)}
.side a.dim{opacity:.35}
.side .n{flex:none;width:24px;height:24px;border-radius:7px;background:var(--surface);border:1px solid var(--line);display:grid;place-items:center;font:600 .74rem var(--display);color:var(--accent2)}
.side .t{flex:1;min-width:0}
.side .c{font-size:.74rem;color:var(--muted);font-variant-numeric:tabular-nums}
.side hr{border:0;border-top:1px solid var(--line);margin:12px 6px}
.scrim{display:none}
main{min-width:0}
.sect-t{font:600 .78rem var(--body);letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:0 0 14px}
.quick{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px;margin-bottom:44px}
.qc{display:flex;flex-direction:column;gap:4px;padding:16px;border-radius:16px;background:var(--surface);border:1px solid var(--line);text-decoration:none;transition:transform .18s,border-color .18s,box-shadow .18s;min-width:0}
.qc:hover{transform:translateY(-3px);border-color:var(--accent);box-shadow:var(--shadow)}
.qn{font:800 1.6rem var(--display);color:var(--accent2)}
.qt{font:600 .98rem/1.25 var(--display)}
.qs{font-size:.8rem;color:var(--muted)}
.summary{margin-bottom:44px}
.tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:16px;background:var(--surface)}
table{border-collapse:collapse;width:100%;min-width:640px;font-size:.92rem}
th,td{text-align:left;padding:12px 16px;border-bottom:1px solid var(--line);vertical-align:top}
th{font:600 .74rem var(--body);letter-spacing:.1em;text-transform:uppercase;color:var(--muted);background:var(--surface2)}
tr:last-child td{border-bottom:0}
td:first-child{font:700 .95rem var(--display);color:var(--accent2)}
.fine{font-size:.82rem;color:var(--muted);margin:10px 2px 0}

.chapter{margin-bottom:18px;scroll-margin-top:132px}
.chapter details{background:var(--surface);border:1px solid var(--line);border-radius:20px}
.chapter summary{list-style:none;display:flex;align-items:center;gap:14px;padding:20px 22px;cursor:pointer;border-radius:20px}
.chapter summary::-webkit-details-marker{display:none}
.chapter summary:hover{background:var(--surface2)}
.sh{flex:1;min-width:0}
.eyebrow{display:block;font:600 .74rem var(--body);letter-spacing:.14em;text-transform:uppercase;color:var(--accent2);margin-bottom:2px}
.chapter h2{font-size:clamp(1.25rem,3vw,1.7rem);font-weight:700;letter-spacing:-.01em}
.count{font-size:.8rem;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:3px 12px;white-space:nowrap}
.chev{flex:none;color:var(--muted);transition:transform .2s}
details[open] .chev{transform:rotate(180deg)}
.chbody{padding:4px 18px 20px;display:flex;flex-direction:column;gap:10px}
.chbody.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr))}
.lead{color:var(--muted);margin:6px 4px 4px}
.chbody.grid .lead{grid-column:1/-1}

.rule,.term,.pend{position:relative;display:flex;gap:14px;align-items:flex-start;padding:14px 16px;border-radius:14px;border:1px solid var(--line);background:var(--bg);transition:border-color .15s,box-shadow .15s;scroll-margin-top:140px;min-width:0}
.rule:hover,.term:hover,.group:hover{border-color:var(--accent)}
.rule:target,.term:target,.group:target{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 30%,transparent)}
.num{flex:none;min-width:3.1rem;text-align:center;padding:3px 8px;border-radius:9px;background:var(--surface2);color:var(--accent2);font:700 .82rem var(--display);text-decoration:none;font-variant-numeric:tabular-nums}
.num:hover{background:var(--accent);color:var(--on-accent)}
.tb{flex:1;min-width:0}
.tb p,.group p{margin:0}
.tb p+p,.group p+p{margin-top:8px}
.rule p{line-height:1.55}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.chip{display:inline-block;font:600 .7rem var(--body);letter-spacing:.06em;text-transform:uppercase;padding:2px 9px;border-radius:999px;margin-left:6px}
.chips .chip{margin-left:0}
.chip.punish{background:var(--danger-bg);color:var(--danger)}
.chip.confirm{background:var(--warn-bg);color:var(--warn)}
.hl{background:none;color:var(--accent2);font-weight:600}
.ex{color:var(--muted);border-left:3px solid var(--accent);padding-left:12px;font-size:.94rem}
.copy{flex:none;width:32px;height:32px;border-radius:9px;border:1px solid transparent;background:transparent;color:var(--muted);display:grid;place-items:center;opacity:0;transition:opacity .15s}
.rule:hover .copy,.term:hover .copy,.copy:focus-visible{opacity:1}
.copy:hover{border-color:var(--line);color:var(--fg)}
@media (hover:none){.copy{opacity:.7}}
.term{align-items:flex-start}
.abbr{flex:none;min-width:4.2rem;max-width:7rem;padding:8px 10px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#5B21B6);color:#fff;font:800 .86rem/1.15 var(--display);text-align:center;overflow-wrap:anywhere}
.term h3{font-size:1.02rem;margin-bottom:4px}
.group{padding:16px;border-radius:14px;border:1px solid var(--line);background:var(--bg);scroll-margin-top:140px}
.gh{display:flex;align-items:center;gap:12px;margin-bottom:8px}
.gh h3{font-size:1.02rem}
.group ul{margin:6px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:6px}
.group li{position:relative;padding-left:20px}
.group li::before{content:"";position:absolute;left:3px;top:.62em;width:7px;height:7px;border-radius:2px;background:var(--accent)}
.pend{background:var(--warn-bg);border-color:transparent}
.pid{flex:none;min-width:2.6rem;text-align:center;padding:3px 8px;border-radius:9px;background:var(--warn);color:#1a1200;font:800 .8rem var(--display)}
.pend p{margin:0;min-width:0}
.ref{color:var(--accent2);font-weight:600;text-underline-offset:3px}
.empty{display:none;text-align:center;padding:60px 16px;color:var(--muted);border:1px dashed var(--line);border-radius:20px}
.empty.show{display:block}
footer{margin-top:50px;padding:28px;border-radius:20px;background:var(--surface);border:1px solid var(--line);display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between}
footer p{margin:0;color:var(--muted);font-size:.9rem}
footer .btn.ghost{border-color:var(--line);color:var(--fg);background:transparent}
#top{position:fixed;right:max(16px,env(safe-area-inset-right,0px));bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:40;opacity:0;pointer-events:none;transition:opacity .2s;background:var(--accent);color:var(--on-accent);border-color:transparent}
#top.show{opacity:1;pointer-events:auto}
#toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));translate:-50% 20px;opacity:0;background:var(--fg);color:var(--bg);padding:10px 18px;border-radius:12px;font-size:.9rem;z-index:80;transition:.25s;pointer-events:none;max-width:90vw}
#toast.show{opacity:1;translate:-50% 0}

@media (max-width:959px){
  .shell{grid-template-columns:minmax(0,1fr);gap:0}
  #menu{display:grid}
  .side{position:fixed;top:0;bottom:0;left:0;z-index:90;width:min(86vw,320px);max-height:none;background:var(--surface);border-right:1px solid var(--line);padding:calc(20px + env(safe-area-inset-top,0px)) 14px calc(20px + env(safe-area-inset-bottom,0px)) max(14px,env(safe-area-inset-left,0px));transform:translateX(-102%);transition:transform .25s}
  .side.open{transform:none;box-shadow:var(--shadow)}
  .scrim.show{display:block;position:fixed;inset:0;background:rgba(5,2,10,.6);z-index:85}
  .status{margin-left:0;width:100%}
}
@media (max-width:520px){
  .chapter summary{padding:16px}
  .count{display:none}
  .chbody{padding:4px 10px 14px}
  .rule,.term,.pend{padding:12px}
  .copy{display:none}
  .stats{gap:22px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
body{margin:0}
</style>


</head>
<body>
<div id="bar"></div>
<header class="hero">
  <div class="hero-in">
    <span class="tagline"><i></i>MTA:SAN · Regulamento oficial</span>
    <h1><span>BMR ROLEPLAY</span></h1>
    <h2>Brasil Mundo Realista · Manual Oficial da Cidade</h2>
    <p class="sub">Todas as regras publicadas pela administração em um só lugar. Busque por palavra, filtre por punição e abra só o capítulo que você precisa.</p>
    <div class="cta">
      <a class="btn primary" href="#conteudo">Começar a ler</a>
      <a class="btn ghost" href="https://docs.google.com/document/d/1gvaJ8X0HXdhz_LSFpjbIHpTWdxvNYMzHDcFGdNFxPkw/edit" target="_blank" rel="noopener">Versão em Google Docs</a>
