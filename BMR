      <button class="fchip" type="button" data-f="confirm" aria-pressed="false">A confirmar</button>
      <button class="linkbtn" id="toggleAll" type="button">Recolher tudo</button>
      <span class="status" id="status" aria-live="polite"></span>
    </div>
  </div>
</div>

<div class="scrim" id="scrim"></div>
<div class="shell" id="top-of-page">
  <nav class="side" id="side" aria-label="Índice do manual">
    <h4>Capítulos</h4>
<a href="#cap-1" data-cap="cap-1"><span class="n">1</span><span class="t">Regras do Discord</span><span class="c">8</span></a>
<a href="#cap-2" data-cap="cap-2"><span class="n">2</span><span class="t">Termos e Definições de Roleplay</span><span class="c">10</span></a>
<a href="#cap-3" data-cap="cap-3"><span class="n">3</span><span class="t">Regras Gerais das Facções</span><span class="c">20</span></a>
<a href="#cap-4" data-cap="cap-4"><span class="n">4</span><span class="t">Regras de Lojinha</span><span class="c">4</span></a>
<a href="#cap-5" data-cap="cap-5"><span class="n">5</span><span class="t">Regras de Joalheria</span><span class="c">4</span></a>
<a href="#cap-6" data-cap="cap-6"><span class="n">6</span><span class="t">Regras das Corporações</span><span class="c">16</span></a>
<a href="#cap-7" data-cap="cap-7"><span class="n">7</span><span class="t">Regras do SAMU</span><span class="c">8</span></a>
<a href="#cap-8" data-cap="cap-8"><span class="n">8</span><span class="t">Regras do Carro-Forte</span><span class="c">4</span></a>
<a href="#cap-9" data-cap="cap-9"><span class="n">9</span><span class="t">Regras de Invasão</span><span class="c">9</span></a>
<a href="#cap-10" data-cap="cap-10"><span class="n">10</span><span class="t">Regras de Sequestro</span><span class="c">9</span></a>
<a href="#cap-11" data-cap="cap-11"><span class="n">11</span><span class="t">Regras de Caixinha</span><span class="c">8</span></a>
<a href="#cap-12" data-cap="cap-12"><span class="n">12</span><span class="t">Áreas Verdes</span><span class="c">13</span></a>
<a href="#cap-13" data-cap="cap-13"><span class="n">13</span><span class="t">Regras do Baú</span><span class="c">3</span></a>
