<button class="iconbtn" id="top" type="button" aria-label="Voltar ao topo"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 15 6-6 6 6"/></svg></button>
<div id="toast" role="status"></div>

<script>
(function(){
var $=function(s){return document.querySelector(s)},$$=function(s){return Array.prototype.slice.call(document.querySelectorAll(s))};
var norm=function(s){return s.normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase()};
var root=document.documentElement,filter='all';
function toast(m){var t=$('#toast');t.textContent=m;t.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(function(){t.classList.remove('show')},2200)}
/* tema */
try{var st=localStorage.getItem('bmr-theme');if(st==='light'||st==='dark')root.setAttribute('data-theme',st)}catch(e){}
$('#theme').addEventListener('click',function(){
  var cur=root.getAttribute('data-theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');
  var nx=cur==='dark'?'light':'dark';root.setAttribute('data-theme',nx);
  try{localStorage.setItem('bmr-theme',nx)}catch(e){}
});
/* busca e filtros */
function apply(){
  var q=norm($('#q').value.trim()),active=!!q||filter!=='all',total=0;
  $$('.unit').forEach(function(u){
    var okQ=!q||u.dataset.text.indexOf(q)>-1;
    var okF=filter==='all'||(u.dataset.tags||'').split(' ').indexOf(filter)>-1;
    u.hidden=!(okQ&&okF);if(!u.hidden)total++;
  });
  $$('.chapter').forEach(function(ch){
    var n=ch.querySelectorAll('.unit:not([hidden])').length;
    ch.hidden=active&&n===0;
    if(active&&n>0)ch.querySelector('details').open=true;
    var l=$('.side a[data-cap="'+ch.id+'"]');if(l)l.classList.toggle('dim',active&&n===0);
  });
  $('#intro').hidden=active;
  $('#empty').classList.toggle('show',active&&total===0);
  $('#status').textContent=active?(total+(total===1?' resultado':' resultados')):'';
}
$('#q').addEventListener('input',apply);
$$('.fchip').forEach(function(b){b.addEventListener('click',function(){
  filter=b.dataset.f;$$('.fchip').forEach(function(x){x.setAttribute('aria-pressed',x===b?'true':'false')});apply();
})});
document.addEventListener('keydown',function(e){
  var tag=(e.target.tagName||'').toLowerCase();
  if(e.key==='/'&&tag!=='input'){e.preventDefault();$('#q').focus()}
  if(e.key==='Escape'){if($('#side').classList.contains('open'))closeMenu();else if($('#q').value){$('#q').value='';apply()}}
});
/* recolher tudo */
var allOpen=true;
$('#toggleAll').addEventListener('click',function(){
  allOpen=!allOpen;$$('.chapter details').forEach(function(d){d.open=allOpen});
  this.textContent=allOpen?'Recolher tudo':'Expandir tudo';
});
/* menu lateral no celular */
function closeMenu(){$('#side').classList.remove('open');$('#scrim').classList.remove('show')}
$('#menu').addEventListener('click',function(){$('#side').classList.add('open');$('#scrim').classList.add('show')});
$('#scrim').addEventListener('click',closeMenu);
$$('#side a').forEach(function(a){a.addEventListener('click',closeMenu)});
/* copiar link da regra */
document.addEventListener('click',function(e){
  var b=e.target.closest('.copy');if(!b)return;
  var url=location.href.split('#')[0]+'#'+b.dataset.id;
  function ok(){toast('Link da regra copiado')}
  function fb(){toast('Link: '+url)}
  try{navigator.clipboard.writeText(url).then(ok,fb)}catch(err){fb()}
});
/* abrir capítulo ao navegar por link */
function goHash(){
  var id=decodeURIComponent(location.hash.slice(1));if(!id)return;
  var el=document.getElementById(id);if(!el)return;
  var d=el.closest('details')||(el.querySelector&&el.querySelector('details'));if(d)d.open=true;
  if(el.hidden){$('#q').value='';filter='all';$$('.fchip').forEach(function(x){x.setAttribute('aria-pressed',x.dataset.f==='all'?'true':'false')});apply()}
  setTimeout(function(){el.scrollIntoView({block:'start'})},30);
}
window.addEventListener('hashchange',goHash);
if(location.hash)goHash();
/* progresso, topo e capítulo ativo */
function onScroll(){
  var h=document.documentElement.scrollHeight-innerHeight,p=h>0?Math.min(1,scrollY/h):0;
  $('#bar').style.transform='scaleX('+p+')';
  $('#top').classList.toggle('show',scrollY>900);
}
addEventListener('scroll',onScroll,{passive:true});onScroll();
$('#top').addEventListener('click',function(){scrollTo({top:0})});
if('IntersectionObserver' in window){
  var io=new IntersectionObserver(function(es){es.forEach(function(en){
    if(en.isIntersecting){$$('.side a[data-cap]').forEach(function(a){a.classList.toggle('on',a.dataset.cap===en.target.dataset.cid)})}
  })},{rootMargin:'-25% 0px -65% 0px'});
  $$('.chapter,#resumo').forEach(function(s){io.observe(s)});
}
})();
</script>

